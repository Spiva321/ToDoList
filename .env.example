# Скопируйте файл в .env и задайте собственные значения.
# Секретный ключ можно сгенерировать командой:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Необязательно: путь к базе данных.
# По умолчанию используется instance/todo.db.
# DATABASE_URL=sqlite:///instance/todo.db

# Включить режим отладки при локальной разработке (1 — включён, 0 — выключен).
FLASK_DEBUG=0
